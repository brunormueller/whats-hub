# Provider de WhatsApp: "evolution" (número próprio, QR) ou "meta" (Cloud API)
WHATSAPP_PROVIDER=evolution

# --- Evolution API (WHATSAPP_PROVIDER=evolution) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque_esta_chave
# A instância NÃO vem daqui: cada conta cadastrada recebe a sua (hub-<id>) e
# pareia o próprio número. Uma URL de webhook serve todas.
# URL que a Evolution chama ao receber mensagem.
# Docker → host: use http://host.docker.internal:3001/webhook
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3001/webhook

# --- WhatsApp Cloud API (WHATSAPP_PROVIDER=meta) ---
WHATSAPP_VERIFY_TOKEN=seu_token_de_verificacao_aqui
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890

# Servidor
PORT=3001
FRONTEND_URL=http://localhost:5173

# Redis (mensagens persistidas por conversa)
REDIS_URL=redis://localhost:6379

# --- IA (Claude / Anthropic) ---
# Sem a chave o servidor sobe normalmente, só não responde sozinho.
ANTHROPIC_API_KEY=
# Modelo usado nas respostas (padrão: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5
# Profundidade de raciocínio: low | medium | high | xhigh | max
# WhatsApp é síncrono para o cliente — "low" mantém a latência baixa.
AI_EFFORT=low
# Teto de tokens por resposta (raciocínio + texto)
AI_MAX_TOKENS=4096
# Mensagens de histórico enviadas ao modelo por conversa
AI_HISTORY_LIMIT=20
# Fuso usado para avaliar o horário de atendimento
AI_TIMEZONE=America/Sao_Paulo

# --- Sessão ---
# Assina os JWT de login. Gere com: openssl rand -hex 32
# Sem ela o servidor sobe, mas usa uma chave aleatória: todos os logins caem
# a cada restart.
JWT_SECRET=
